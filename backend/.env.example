# ─────────────────────────────────────────────────────────────────────────────
#  .env.example — Electro-Treasur Backend Configuration Template
#
#  ИНСТРУКЦИЯ:
#  1. Скопируй этот файл: cp .env.example .env
#  2. Сгенерируй SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
#  3. Никогда не коммить .env в репозиторий (.gitignore уже защищает)
#
#  Все переменные используют префикс ET_ (env_prefix в pydantic-settings)
# ─────────────────────────────────────────────────────────────────────────────

# ── JWT Security (ОБЯЗАТЕЛЬНО — без этого приложение не запустится) ──────────
ET_SECRET_KEY="your-super-secret-256-bit-key-here-generate-with-secrets-token-hex-32"
ET_ALGORITHM="HS256"

# ── PostgreSQL ────────────────────────────────────────────────────────────────
ET_DATABASE_URL="postgresql+asyncpg://electro:CHANGE_ME_STRONG_PASSWORD@localhost:5432/electro_treasur"

# ── Redis ─────────────────────────────────────────────────────────────────────
ET_REDIS_URL="redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0"
ET_ARQ_REDIS_URL="redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/1"

# ── Optional tuning ───────────────────────────────────────────────────────────
# ET_DB_POOL_SIZE=20
# ET_DB_MAX_OVERFLOW=10
# ET_REDIS_INSIGHT_TTL=86400
