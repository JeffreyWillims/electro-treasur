# Root .env — переменные для подстановки ${...} в docker-compose*.yml.
# Скопируй в .env и заполни. Файл .env — в .gitignore, секреты не коммитим.
# docker compose автоматически подхватывает .env из этой директории.

# ── База данных ────────────────────────────────────────────────────────────
# Пароль пользователя БД `electro`. ОБЯЗАТЕЛЬНО задать длинным случайным
# значением ДО первого прод-деплоя: POSTGRES_PASSWORD применяется только при
# первой инициализации пустого тома pg_data. Для уже существующей БД пароль
# меняется через `ALTER USER electro WITH PASSWORD '...'`, а не этой переменной.
# Генерация: openssl rand -base64 32
POSTGRES_PASSWORD=change_me_use_a_long_random_secret

# ── Grafana (оверлей мониторинга) ──────────────────────────────────────────
# Дефолт admin/admin запрещён — переменные обязательны, иначе compose упадёт.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_strong_password

# ── Версия backend-образа (прод-оверлей) ───────────────────────────────────
# Тег образа backend/arq-worker/telegram-bot из GHCR. По умолчанию latest.
# Пиннинг + откат: укажи конкретный тег предыдущей сборки и `up -d`.
# Пример: BACKEND_IMAGE_TAG=sha-1a2b3c4
BACKEND_IMAGE_TAG=latest
